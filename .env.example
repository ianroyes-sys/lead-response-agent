# Copy this file to .env and fill in your values.

# Required for live drafting. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Slack Incoming Webhook URL — drafts get posted to a channel for
# one-tap review. Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: override the Claude model used for drafting (default claude-opus-4-8)
ANTHROPIC_MODEL=
